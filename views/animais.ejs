<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <%- include('partials/head', { titulo: 'Animais' }) %>
</head>

<body class="ap">

  <%- include('partials/navbar') %>

    <main>

      <header class="ap-cabecalho">
        <div class="ap-blob"
          style="width: 420px; height: 300px; right: -120px; top: -80px; background: var(--ap-verde-claro); border-radius: 58% 42% 55% 45% / 52% 48% 52% 48%;"
          aria-hidden="true"></div>
        <div class="container position-relative">
          <h1>Animais para adoção</h1>
          <%- include('partials/aviso') %>
            <p class="ap-subtitulo mb-0">
              Confira os animais disponíveis, em processo de adoção e os que já encontraram um lar.
            </p>
        </div>
      </header>

      <section class="container pb-5">

        <!-- Busca e filtros (funcionam no navegador, sem recarregar a página) -->
        <div class="ap-filtros mb-4" role="search">

          <label class="ap-busca mb-0">
            <span class="visually-hidden">Buscar pelo nome</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"
              aria-hidden="true">
              <circle cx="11" cy="11" r="7" />
              <path d="m20 20-3.5-3.5" />
            </svg>
            <input type="search" id="filtroBusca" placeholder="Buscar pelo nome..." autocomplete="off">
          </label>

          <label class="mb-0">
            <span class="visually-hidden">Espécie</span>
            <select id="filtroEspecie" class="ap-filtro">
              <option value="">Espécie</option>
              <option value="Cachorro">Cachorro</option>
              <option value="Gato">Gato</option>
              <option value="Outro">Outro</option>
            </select>
          </label>

          <label class="mb-0">
            <span class="visually-hidden">Idade</span>
            <select id="filtroIdade" class="ap-filtro">
              <option value="">Idade</option>
              <option value="filhote">Filhote (até 1 ano)</option>
              <option value="adulto">Adulto (2 a 7 anos)</option>
              <option value="idoso">Idoso (8 anos ou mais)</option>
            </select>
          </label>

          <label class="mb-0">
            <span class="visually-hidden">Situação</span>
            <select id="filtroStatus" class="ap-filtro">
              <option value="">Situação</option>
              <option value="disponivel">Disponível</option>
              <option value="em_processo">Em processo</option>
              <option value="adotado">Adotado</option>
            </select>
          </label>

          <button type="button" id="filtroLimpar" class="ap-limpar ap-oculto">Limpar filtros</button>

          <span id="filtroContador" class="ap-meta ms-auto" aria-live="polite"></span>
        </div>

        <% if (animais.length===0) { %>

          <div class="ap-vazio">
            <div class="ap-vazio-icone">🐾</div>
            <p class="mb-3">Nenhum animal cadastrado no momento.</p>
            <% if (usuarioLogado) { %>
              <a href="/animais/novo" class="btn btn-ap">Cadastrar o primeiro</a>
              <% } %>
          </div>

          <% } %>

            <div id="semResultado" class="ap-vazio ap-oculto mb-4">
              <div class="ap-vazio-icone">🔍</div>
              <p class="mb-0">Nenhum animal combina com esses filtros. Tente mudar a busca.</p>
            </div>

            <div class="row g-3 g-lg-4" data-lista-animais>

              <% animais.forEach((animal, indice)=> { %>

                <div class="col-6 col-md-4 col-lg-3" data-animal data-nome="<%= animal.nome %>"
                  data-especie="<%= animal.especie %>" data-idade="<%= animal.idade %>"
                  data-status="<%= animal.status_adocao %>">

                  <a href="/animais/<%= animal.id_animal %>" class="ap-pet-card ap-cor-<%= indice % 8 %>"
                    aria-label="Conhecer <%= animal.nome %>">

                    <img src="/uploads/<%= animal.arquivo %>" alt="Foto de <%= animal.nome %>" loading="lazy">

                    <span class="ap-status ap-status-<%= animal.status_adocao %>">
                      <%= animal.status_adocao==='disponivel' ? 'Disponível' : animal.status_adocao==='em_processo'
                        ? 'Em processo' : 'Adotado' %>
                    </span>

                    <span class="ap-pet-rotulo">
                      <span class="ap-pet-nome">
                        <%= animal.nome %>
                      </span>
                      <span class="ap-pet-info">
                        <span>
                          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <circle cx="5" cy="9" r="2.2" />
                            <circle cx="9.5" cy="5" r="2.2" />
                            <circle cx="14.5" cy="5" r="2.2" />
                            <circle cx="19" cy="9" r="2.2" />
                            <path
                              d="M12 10.5c-3 0-6 4.5-6 7.2 0 1.6 1.2 2.3 2.6 2.3 1.3 0 2.2-.7 3.4-.7s2.1.7 3.4.7c1.4 0 2.6-.7 2.6-2.3 0-2.7-3-7.2-6-7.2z" />
                          </svg>
                          <%= animal.especie %>
                        </span>
                        <span>
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                            stroke-linecap="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" />
                            <path d="M12 7v5l3 2" />
                          </svg>
                          <%= animal.idade===0 ? 'Menos de 1 ano' : animal.idade===1 ? '1 ano' : animal.idade + ' anos'
                            %>
                        </span>
                      </span>
                    </span>
                  </a>

                  <% if (usuarioLogado && usuarioLogado.id===animal.id_usuario) { %>

                    <div class="ap-card-acoes">

                      <a href="/animais/<%= animal.id_animal %>/editar" class="btn btn-ap-contorno btn-sm">
                        Editar
                      </a>

                      <form action="/animais/<%= animal.id_animal %>/excluir" method="POST"
                        onsubmit="return confirm('Tem certeza que deseja excluir este animal?');">

                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                        <button type="submit" class="btn btn-ap-perigo btn-sm">
                          Excluir
                        </button>

                      </form>

                    </div>

                    <% } %>

                </div>

                <% }) %>

            </div>

      </section>

    </main>

    <%- include('partials/rodape') %>
      <%- include('partials/scripts') %>
</body>

</html>