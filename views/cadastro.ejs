<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <%- include('partials/head', { titulo: 'Criar conta' }) %>
</head>

<body class="ap">

  <%- include('partials/navbar') %>

    <main class="ap-auth">
      <div class="container">
        <div class="row align-items-center g-5">

          <div class="col-lg-6">
            <div class="ap-painel mx-auto" style="max-width: 500px;">
              <%- include('partials/aviso') %>
                <h1 class="h2 mb-1">Crie sua conta 🐾</h1>
                <p class="text-muted mb-4">Leva menos de um minuto para começar a adotar.</p>

                <form action="/cadastro" method="POST" enctype="multipart/form-data">

                  <div class="d-flex align-items-center gap-3 mb-4">
                    <img id="previewPerfil" class="ap-preview-foto ap-oculto" alt="Prévia da foto de perfil">
                    <div class="flex-grow-1">
                      <label for="foto" class="form-label">Foto de perfil</label>
                      <input type="file" id="foto" name="foto" accept="image/*" class="form-control"
                        data-preview="previewPerfil" required>
                    </div>
                  </div>

                  <div class="mb-3">
                    <label for="nome" class="form-label">Nome</label>
                    <input type="text" id="nome" name="nome" class="form-control" autocomplete="name" required>
                  </div>

                  <div class="mb-3">
                    <label for="email" class="form-label">E-mail</label>
                    <input type="email" id="email" name="email" class="form-control" placeholder="voce@email.com"
                      autocomplete="email" required>
                  </div>

                  <div class="mb-4">
                    <label for="senha" class="form-label">Senha</label>
                    <input type="password" id="senha" name="senha" class="form-control" autocomplete="new-password"
                      required>
                  </div>

                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                  <button type="submit" class="btn btn-ap w-100">
                    Cadastrar
                  </button>

                </form>

                <p class="text-center mt-4 mb-0">
                  Já tem conta?
                  <a href="/login" class="fw-semibold">Entrar</a>
                </p>

            </div>
          </div>

          <%- include('partials/ilustracaoAuth', { inicio: 1 }) %>

        </div>
      </div>
    </main>

    <%- include('partials/rodape') %>
      <%- include('partials/scripts') %>
</body>

</html>