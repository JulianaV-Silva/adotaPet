<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <%- include('partials/head', { titulo: 'Editar animal' }) %>
</head>

<body class="ap">

  <%- include('partials/navbar') %>

    <main class="container py-4 pb-5">
      <div class="row justify-content-center">
        <div class="col-lg-7 col-xl-6">

          <a href="/animais" class="ap-voltar">← Voltar aos animais</a>

          <div class="ap-painel">

            <h1 class="h2 mb-4">Editar <%= animal.nome %> 🐾</h1>
            <%- include('partials/aviso') %>
              <form action="/animais/<%= animal.id_animal %>/editar" method="POST" enctype="multipart/form-data">

                <div class="d-flex align-items-center gap-3 mb-4">
                  <img id="previewAnimal" src="/uploads/<%= animal.arquivo %>" class="ap-preview-foto"
                    alt="Foto atual de <%= animal.nome %>">
                  <div class="flex-grow-1">
                    <label for="arquivo" class="form-label">Substituir foto (opcional)</label>
                    <input type="file" id="arquivo" name="arquivo" accept="image/jpeg,image/png,image/webp"
                      class="form-control" data-preview="previewAnimal">
                  </div>
                </div>

                <div class="mb-3">
                  <label for="nome" class="form-label">Nome do animal</label>
                  <input type="text" id="nome" name="nome" value="<%= animal.nome %>" class="form-control"
                    maxlength="100" required>
                </div>

                <fieldset class="mb-3">
                  <legend class="form-label fs-6">Espécie</legend>
                  <div class="ap-especies">
                    <label class="ap-opcao"><input type="radio" name="especie" value="Cachorro" required
                        <%=animal.especie==='Cachorro' ? 'checked' : '' %>><span>🐶 Cachorro</span></label>
                    <label class="ap-opcao"><input type="radio" name="especie" value="Gato" <%=animal.especie==='Gato'
                        ? 'checked' : '' %>><span>🐱 Gato</span></label>
                    <label class="ap-opcao"><input type="radio" name="especie" value="Outro" <%=animal.especie==='Outro'
                        ? 'checked' : '' %>><span>🐰 Outro</span></label>
                  </div>
                </fieldset>

                <div class="mb-3" style="max-width: 200px;">
                  <label for="idade" class="form-label">Idade (anos)</label>
                  <input type="number" id="idade" name="idade" min="0" max="100" value="<%= animal.idade %>"
                    class="form-control" required>
                </div>

                <div class="mb-4">
                  <label for="descricao" class="form-label">Descrição</label>
                  <textarea id="descricao" name="descricao" rows="4"
                    class="form-control"><%= animal.descricao || '' %></textarea>
                </div>

                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="d-flex flex-column flex-sm-row gap-2">
                  <button type="submit" class="btn btn-ap flex-fill">
                    Salvar alterações
                  </button>
                  <a href="/animais" class="btn btn-ap-contorno flex-fill">
                    Cancelar
                  </a>
                </div>

              </form>

          </div>
        </div>
      </div>
    </main>

    <%- include('partials/rodape') %>
      <%- include('partials/scripts') %>
</body>

</html>