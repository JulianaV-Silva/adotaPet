<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <%- include('partials/head', { titulo: 'Solicitações recebidas' }) %>
</head>

<body class="ap">

  <%- include('partials/navbar') %>

    <main>

      <header class="ap-cabecalho">
        <div class="container">
          <h1>Solicitações recebidas</h1>
          <%- include('partials/aviso') %>
            <p class="ap-subtitulo mb-0">
              Veja quem demonstrou interesse nos animais que você cadastrou.
            </p>
        </div>
      </header>

      <section class="container pb-5">

        <% if (solicitacoes.length===0) { %>

          <div class="ap-vazio">
            <div class="ap-vazio-icone">📬</div>
            <p class="mb-0">Você ainda não recebeu solicitações de interesse.</p>
          </div>

          <% } else { %>

            <div class="row g-4">

              <% solicitacoes.forEach((solicitacao)=> { %>

                <div class="col-lg-6">

                  <article class="ap-item">

                    <a href="/animais/<%= solicitacao.id_animal %>"
                      class="ap-item-foto ap-cor-<%= solicitacao.id_animal % 8 %>">
                      <img src="/uploads/<%= solicitacao.arquivo %>" alt="Foto de <%= solicitacao.nome_animal %>">
                    </a>

                    <div class="ap-item-corpo">

                      <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                        <h2>
                          <%= solicitacao.nome_animal %>
                        </h2>
                        <%- include('partials/statusSolicitacao', { status: solicitacao.status }) %>
                      </div>

                      <p class="mb-0">
                        <strong>Interessado:</strong>
                        <%= solicitacao.interessado %>
                      </p>

                      <p class="ap-mensagem">
                        <%= solicitacao.mensagem || 'Nenhuma mensagem enviada.' %>
                      </p>

                      <p class="ap-meta mb-0">
                        Solicitação nº <%= solicitacao.id_interesse %> ·
                          enviada em <%= new Date(solicitacao.data_solicitacao).toLocaleDateString('pt-BR') %>
                      </p>

                      <% if (solicitacao.status==='pendente' ) { %>

                        <div class="d-flex gap-2 mt-3">

                          <form action="/solicitacoes/<%= solicitacao.id_interesse %>/responder" method="POST">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="status" value="aceito">
                            <button type="submit" class="btn btn-ap btn-sm">
                              Aceitar
                            </button>
                          </form>

                          <form action="/solicitacoes/<%= solicitacao.id_interesse %>/responder" method="POST">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="status" value="recusado">
                            <button type="submit" class="btn btn-ap-perigo btn-sm">
                              Recusar
                            </button>
                          </form>

                        </div>

                        <% } %>

                    </div>
                  </article>

                </div>

                <% }) %>

            </div>

            <% } %>

      </section>

    </main>

    <%- include('partials/rodape') %>
      <%- include('partials/scripts') %>
</body>

</html>